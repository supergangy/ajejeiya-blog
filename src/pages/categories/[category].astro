---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, termSlug, summary, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const names = [...new Set(posts.map((p) => p.data.category))];
  return names.map((category) => ({
    params: { category: termSlug(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

interface Props { category: string; posts: Post[] }
const { category, posts } = Astro.props;
---
<Base title={category} description={summary(`${category} 글 ${posts.length}편: ${posts.map((p) => p.data.title).join(", ")}`)}>
  <header class="page-head">
    <p><a href="/categories/">카테고리</a></p>
    <h1>{category}</h1>
    <p>글 {posts.length}개</p>
  </header>
  <PostList posts={posts} />
</Base>
