---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts, countBy, categoryUrl, formatDate, isoKst } from "../lib/posts";
import { SITE_DESCRIPTION, SITE_TITLE, AUTHOR, GITHUB_URL, NAVER_BLOG_URL } from "../consts";

const posts = await getPosts();
const categories = countBy(posts, (p) => [p.data.category]);
// 머리말 한 줄에 넣을 실제 값(빌드할 때 계산)
const lastUpdated = posts.reduce<Date | undefined>((max, p) => {
  const d = p.data.updatedDate ?? p.data.pubDate;
  return !max || d > max ? d : max;
}, undefined);

const SITE = Astro.site!.href.replace(/\/$/, "");
// 검색 결과 설명문(80~120자). 사이트가 무엇을 다루는지 드러나게 쓴다.
const homeDescription =
  "스캔 PDF OCR 프로그램 등 직접 만든 무료 프로그램과 구글 클라우드, 파이썬, 블로그 운영(GitHub Pages·가비아 도메인)에서 겪은 문제와 해결 방법을 정리합니다.";
// 구글은 WebSite의 name/alternateName을 검색 결과의 '사이트 이름'으로 참고한다.
const jsonLd = [
  {
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    name: SITE_TITLE,
    alternateName: ["종갓 IT블로그", "ajejeiya.cloud"],
    url: `${SITE}/`,
    inLanguage: "ko-KR",
    description: homeDescription,
    publisher: { "@id": `${SITE}/#person` },
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${SITE}/search/?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": "Person",
    "@id": `${SITE}/#person`,
    name: AUTHOR,
    url: `${SITE}/about/`,
    sameAs: [GITHUB_URL, NAVER_BLOG_URL],
  },
];
---
<Base pageTitle={`${SITE_TITLE} - 직접 만든 프로그램과 IT 팁`} description={homeDescription} jsonLd={jsonLd}>
  <section class="intro">
    <p class="eyebrow">
      <span>글 <span class="num">{posts.length}</span>편</span><span aria-hidden="true">/</span><span>카테고리 <span class="num">{categories.length}</span>개</span>
      {lastUpdated && <><span aria-hidden="true">/</span><span>업데이트 <time datetime={isoKst(lastUpdated)}>{formatDate(lastUpdated)}</time></span></>}
    </p>
    <h1><span class="phrase">직접 만들고,</span> <span class="phrase">써 보고,</span> <span class="phrase">정리합니다</span></h1>
    <p>{SITE_DESCRIPTION} 만든 프로그램은 모두 무료로 공개해요.</p>
  </section>

  {categories.length > 0 && (
    <ul class="cat-index" aria-label="카테고리">
      {categories.map(([name, count]) => (
        <li>
          <a href={categoryUrl(name)}>
            <span>{name}</span>
            <span class="count num">{String(count).padStart(2, "0")}<span class="sr-only">편</span></span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <div class="section-head">
    <h2 class="section-title">최근 글</h2>
    <a href="/blog/">전체 글 <span class="num">{posts.length}</span> →</a>
  </div>
  <PostList posts={posts.slice(0, 10)} />
</Base>
