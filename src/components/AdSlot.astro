---
import { ADSENSE_CLIENT } from "../consts";

// 애드센스 승인 전(ADSENSE_CLIENT가 비어 있을 때)이나 슬롯 번호가 없으면 아무것도 그리지 않는다.
interface Props { slot: string }
const { slot } = Astro.props;
---
{ADSENSE_CLIENT && slot && (
  <div class="ad-slot" aria-label="광고">
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}
      data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
